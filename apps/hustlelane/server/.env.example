NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/hustlelane

# REQUIRED in production — 32+ random characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated frontend origins allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5174

# Production: leave false / unset. Development defaults to demo UI enabled.
ENABLE_DEMO_ACCOUNTS=false

# Never set ALLOW_SEED=true on a live DB unless you intend to wipe it
# ALLOW_SEED=true

# Adzuna — server-only secrets (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=za

# Optional rate limits
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=30
# LANES_RATE_LIMIT_MAX=40
